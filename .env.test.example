# ============================================================================
# Frontend test environment — Vite reads this when started in `test` mode
# (npm run dev:test). Points the app at the LOCAL Supabase stack.
#
# Copy to `.env.test` and fill the two values marked FILL ME.
# `.env.test` is gitignored; this .example file is safe to commit.
# ============================================================================

# --- Local Supabase stack (printed by `npx supabase status`) -----------------
# These are the well-known local dev keys — same on every machine, NOT secret.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Some tooling reads these aliases too:
VITE_SUPABASE_PROJECT_ID=spice-and-slice-bazaar
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Clerk (REQUIRED — the app throws without it) ----------------------------
# Use your Clerk **Development** instance publishable key (starts pk_test_).
# Dashboard → API Keys → Development. This is the only value you MUST fill for
# the UI to boot.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_FILL_ME

# --- Mapbox (needed only for the address-autocomplete / delivery flows) ------
# The same prod token works (read-only). Leave blank to skip map features.
VITE_MAPBOX_ACCESS_TOKEN=

# --- Analytics / monitoring — intentionally OFF in test ----------------------
# PostHog no-ops when blank; Sentry is disabled outside production builds.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
VITE_SENTRY_DSN=
