# ============================================================================
# Edge-function test secrets — loaded by:
#   npx supabase functions serve --env-file supabase/functions/.env.test
#
# Copy to `supabase/functions/.env.test` and fill the FILL ME values.
# `.env.test` is gitignored; this .example is safe to commit.
# ============================================================================

# --- Local Supabase --------------------------------------------------------
# Do NOT set SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY here —
# the local edge runtime reserves the SUPABASE_ prefix and injects them itself.

# --- Clerk (REQUIRED for any authenticated function) -------------------------
# Use your Clerk **Development** instance values. JWKS is a public URL, so it
# verifies fine from a local function. Get these from:
#   Clerk Dashboard → API Keys (dev) and the Frontend API / JWKS endpoint.
CLERK_ISSUER_URL=https://FILL_ME.clerk.accounts.dev
CLERK_JWKS_URL=https://FILL_ME.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_FILL_ME
CLERK_WEBHOOK_SECRET=whsec_FILL_ME

# --- Stripe TEST mode (never live keys here) ---------------------------------
# Dashboard → Developers → API keys → Test mode. Card 4242 4242 4242 4242.
STRIPE_SECRET_KEY=sk_test_FILL_ME
# Printed by `stripe listen` when you start webhook forwarding (whsec_...).
# The launcher script captures this for you; paste it here if running manually.
STRIPE_WEBHOOK_SECRET=whsec_FILL_ME

# --- Resend ------------------------------------------------------------------
# Must be NON-EMPTY: some functions build `new Resend(KEY)` at module load and
# the SDK throws on an empty key (crashing the worker). A dummy value is fine —
# the real send is guarded and fails softly, so no emails actually go out.
RESEND_API_KEY=re_dummy_local_test_key

# --- Misc service config ------------------------------------------------------
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:5173
MAPBOX_ACCESS_TOKEN=
PRINTER_API_KEY=test-printer-key
CRON_SECRET=test-cron-secret

# --- Optional integrations (safe to leave blank in test) ---------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
PEXELS_API_KEY=
SLACK_WEBHOOK_URL=
